{
  "name": "trainspotters-intl",
  "private": true,
  "scripts": {
    "lint": "eslint app/javascript",
    "lint:fix": "eslint --fix app/javascript",
    "lint:css": "stylelint 'app/assets/stylesheets/**/*.scss'",
    "format": "dprint check",
    "format:write": "dprint fmt",
    "format:css": "stylelint --fix 'app/assets/stylesheets/**/*.scss'",
    "typecheck": "tsc --noEmit",
    "audit:js": "yarn npm audit --all --recursive",
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --watch=forever",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --output=./app/assets/builds/application.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\""
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "@rails/activestorage": "^8.1.300",
    "autoprefixer": "^10.5.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "sass": "^1.100.0"
  },
  "version": "0.1.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dprint": "^0.47.6",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-plugin-n": "^17.0.0",
    "eslint-plugin-promise": "^7.0.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.16.0",
  "browserslist": [
    "defaults"
  ],
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "dprint@0.47.6": true,
    "esbuild@0.28.1": true
  }
}
