    "@rails/ujs": "^6.0.0",
    "@rails/webpacker": "5.4.2",
    "babel-loader": "^8.2.2",
    "bootstrap": "^5.3.8",
    "material-components-web": "12.0.0",
    "node-releases": "^2.0.38",
    "turbolinks": "^5.2.0",
    "webpack": "^4.46.0",
    "webpack-cli": "^3.3.12"
  },
  "version": "0.1.0",
  "devDependencies": {
    "@prettier/plugin-ruby": "^4.0.4",
    "@prettier/plugin-xml": "^3.4.2",
    "eslint": "8",
    "eslint-config-standard": "17",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "16",
    "eslint-plugin-promise": "6",
