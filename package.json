{
  "name": "trainspotters-intl",
  "private": true,
  "scripts": {
    "webpack": "bin/webpack",
    "webpack:watch": "bin/webpack --watch",
    "webpack:compile": "RAILS_ENV=production NODE_ENV=production bin/webpack",
    "webpack:dev-server": "bin/webpack-dev-server",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint app/javascript",
    "format": "prettier app/javascript --check",
