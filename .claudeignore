# Bundler
/.bundle

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Uploaded files
/storage/*
!/storage/.keep
/public/uploads

# Asset builds (esbuild / Propshaft / Sprockets)
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Node / Yarn
/node_modules
.yarn/cache
.yarn/install-state.gz
/yarn-error.log
yarn-debug.log*
.yarnrc.local

# TypeScript
*.tsbuildinfo

# ESLint / Prettier
.eslintcache
.prettiercache

# Credentials and secrets
.env*
/config/*.key

# macOS / Linux filesystem
*.swp
.DS_Store

# Editor / IDE
.byebug_history
.rvmrc
rerun.txt

# Test artifacts
/coverage/
/test/tmp/
/test/version_tmp/
capybara-*.html

# Documentation
/.yardoc/
/_yardoc/
/doc/
/rdoc/

# Vendored bundles
/vendor/bundle
