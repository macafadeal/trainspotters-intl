<nav class="navbar navbar-expand-lg navbar-light bg-white py-2">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
      <i class="bi bi-train-front-fill"></i>
      <span>Trainspotters Int'l</span>
    <% end %>
    <button class="navbar-toggler border-0" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
        <li class="nav-item">
          <%= link_to trains_path, class: "nav-link" do %>
            <i class="bi bi-collection"></i> Gallery
          <% end %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to new_train_path, class: "nav-link" do %>
              <i class="bi bi-plus-circle"></i> Catalog
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to edit_user_registration_path, class: "nav-link" do %>
              <i class="bi bi-person"></i> Profile
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link text-danger" do %>
              <i class="bi bi-box-arrow-right"></i> Sign out
            <% end %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to new_user_session_path, class: "nav-link" do %>
              <i class="bi bi-box-arrow-in-right"></i> Sign in
            <% end %>
          </li>
          <li class="nav-item ms-1">
            <%= link_to "Sign up", new_user_registration_path, class: "btn btn-dark btn-sm px-3" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
