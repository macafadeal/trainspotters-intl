<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Trainspotters Int'l" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="description" content="Trainspotters Int'l - A community-driven gallery for train enthusiasts to catalog and share railway photography worldwide." />
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body data-page="<%= "#{controller_name}##{action_name}" %>">
    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>
    <main class="<%= current_page?(root_path) ? '' : 'container py-4' %>">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
