<% content_for :title, "Trainspotters Int'l" %>
<div class="hero-section text-white" style="background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url(https://upload.wikimedia.org/wikipedia/commons/3/3a/Serie_106_de_Renfe.jpg)">
  <div class="container text-center py-5">
    <p class="text-white-50 small text-uppercase fw-semibold letter-spacing-wide mb-3">Community Railway Gallery</p>
    <h1 class="display-4 display-md-3 fw-bold mb-4">Trainspotters Int'l</h1>
    <p class="lead hero-lead mb-5 mx-auto">
      A community-driven gallery for train enthusiasts to catalog and share railway photography worldwide.
    </p>
    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center align-items-center">
      <%= link_to "Explore Gallery", trains_path, class: "btn btn-light btn-lg px-5 w-100 w-sm-auto" %>
      <% unless user_signed_in? %>
        <%= link_to "Join the Community", new_user_registration_path, class: "btn btn-outline-light btn-lg px-5 w-100 w-sm-auto" %>
      <% end %>
    </div>
    <p class="mt-5 small text-white-50">
      Photo: Fernando Diaz Villanueva, CC BY-SA 4.0 via Wikimedia Commons
    </p>
  </div>
</div>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <h2 class="h4 fw-semibold mb-3">About this project</h2>
      <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4">
        <a href="https://github.com/macafadeal" target="_blank" rel="noopener" class="flex-shrink-0 text-decoration-none text-center d-flex flex-column align-items-center gap-1">
          <img src="https://avatars.githubusercontent.com/u/56342944?v=4"
               alt="Mateus Albuquerque"
               class="rounded-circle"
               width="72" height="72">
          <span class="small text-muted d-flex align-items-center gap-1">
            <i class="bi bi-github"></i> @macafadeal
          </span>
        </a>
        <div class="text-center text-sm-start">
          <p class="text-muted mb-3">
            I started this project during the Web Development Bootcamp at Le Wagon Lisbon. It's an easy-to-use platform for train enthusiasts to catalog sightings and share their passion with the community.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
