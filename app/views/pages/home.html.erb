<% content_for :title, "Welcome | Trainspotters Int'l" %>

<div class="hero-section text-white text-center py-5" style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url(https://upload.wikimedia.org/wikipedia/commons/7/78/Renfe_clase_100.JPG); background-size: cover; background-position: center; min-height: 80vh; display: flex; align-items: center;">
  <div class="container">
    <h1 class="display-3 fw-bold mb-4">Welcome to Trainspotters Int'l</h1>
    <p class="lead mb-5 mx-auto" style="max-width: 800px;">
      Capturing the beauty of railways worldwide. An intuitive gallery designed for amateur train photography with modern standards and simplicity.
    </p>

    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
      <%= link_to "Explore Gallery", trains_path, class: "btn btn-primary btn-lg px-4 gap-3" %>
      <% unless user_signed_in? %>
        <%= link_to "Join the Community", new_user_registration_path, class: "btn btn-outline-light btn-lg px-4" %>
      <% end %>
    </div>

    <div class="mt-5 pt-5">
      <p class="small text-white-50">
        Photo ©: dewet from London, United Kingdom, CC BY-SA 2.0, via Wikimedia Commons
      </p>
    </div>
  </div>
</div>

<div class="container py-5 mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10 text-center">
      <h2 class="mb-4">Why Trainspotters Int'l?</h2>
      <p class="text-muted fs-5">
        This project was started by Mateus Albuquerque during his Web Development Bootcamp at Le Wagon Lisbon.
        It aims to provide an easy-to-use platform for train enthusiasts to catalog their sightings and share their passion with the community.
      </p>
    </div>
  </div>
</div>
