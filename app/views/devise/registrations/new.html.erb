<div class="row justify-content-center py-5">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 text-center">Sign up</h1>
        <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false } }) do |f| %>
          <%= f.error_notification %>
          <%= f.input :email, label: "Email",
                input_html: { type: "email", autocomplete: "email" },
                hint: "e.g. name@example.com" %>
          <%= f.input :password, label: "Password",
                input_html: { autocomplete: "new-password" },
                hint: "8+ characters with at least one letter and one number" %>
          <%= f.input :password_confirmation, label: "Confirm password",
                input_html: { autocomplete: "new-password" } %>
          <div class="d-grid mt-3">
            <%= f.button :submit, "Sign up", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
        <div class="mt-3 text-center small">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
