<div class="row justify-content-center py-5">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 text-center">Log in</h1>
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
          <%= f.input :email, label: "Email",
                input_html: { type: "email", autocomplete: "email" } %>
          <%= f.input :password, label: "Password",
                input_html: { autocomplete: "current-password" } %>
          <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
          <div class="d-grid mt-3">
            <%= f.button :submit, "Log in", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
        <div class="mt-3 text-center small">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
