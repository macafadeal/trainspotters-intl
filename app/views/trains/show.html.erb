<% content_for :title, "#{@train.series} | Trainspotters Int'l" %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-7">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <%= link_to "Gallery", trains_path, class: "text-muted text-decoration-none" %>
        </li>
        <li class="breadcrumb-item active text-dark fw-medium"><%= @train.series %></li>
      </ol>
    </nav>
    <div class="card border-0 shadow-sm overflow-hidden">
      <% if @train.photo.attached? %>
        <%= cl_image_tag @train.photo.key, crop: :fill,
              class: "train-photo", alt: "#{@train.series} train photograph" %>
      <% else %>
        <div class="d-flex flex-column align-items-center justify-content-center w-100" style="height:320px;background:#f8f9fa">
          <i class="bi bi-train-front-fill" style="font-size:5rem;color:#dee2e6"></i>
          <span class="mt-3" style="font-size:0.875rem;color:#adb5bd;letter-spacing:0.03em">No photo yet</span>
        </div>
      <% end %>
      <div class="card-body p-4 p-md-5">
        <h1 class="h2 fw-bold mb-1"><%= @train.series %></h1>
        <p class="text-muted mb-4"><%= @train.manufacturer %></p>
        <hr class="my-4">
        <dl class="row mb-0">
          <dt class="col-sm-4 text-muted fw-normal small text-uppercase letter-spacing-1">Manufacturer</dt>
          <dd class="col-sm-8 mb-3"><%= @train.manufacturer %></dd>
          <dt class="col-sm-4 text-muted fw-normal small text-uppercase letter-spacing-1">Main Operator</dt>
          <dd class="col-sm-8 mb-0"><%= @train.main_operator %></dd>
        </dl>
        <hr class="my-4">
        <div class="d-flex gap-2 flex-wrap align-items-center">
          <%= link_to trains_path, class: "btn btn-outline-secondary btn-sm" do %>
            <i class="bi bi-arrow-left me-1"></i> Back to Gallery
          <% end %>
          <% if @train.user == current_user %>
            <%= link_to edit_train_path(@train), class: "btn btn-outline-dark btn-sm" do %>
              <i class="bi bi-pencil me-1"></i> Edit
            <% end %>
            <%= button_to train_path(@train), method: :delete,
                  class: "btn btn-outline-danger btn-sm",
                  data: { turbo_confirm: "Delete this entry?" } do %>
              <i class="bi bi-trash me-1"></i> Delete
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
