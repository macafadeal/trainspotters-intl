<% content_for :title, "#{@train.series} | Trainspotters Int'l" %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "List", trains_path %></li>
        <li class="breadcrumb-item active"><%= @train.series %></li>
      </ol>
    </nav>

    <div class="card shadow border-0 overflow-hidden">
      <% if @train.photo.attached? %>
        <%= cl_image_tag @train.photo.key, crop: :fill,
              class: "train-photo img-fluid", alt: "#{@train.series} train photograph" %>
      <% else %>
        <img src="https://images.unsplash.com/photo-1532105956626-ceec02640ef3?auto=format&fit=crop&q=80&w=800&h=400" class="img-fluid w-100" alt="Train placeholder">
      <% end %>

      <div class="card-body p-4">
        <h1 class="display-4"><%= @train.series %></h1>
        <hr>
        <dl class="row mb-0">
          <dt class="col-sm-4 text-muted fw-normal">Manufacturer</dt>
          <dd class="col-sm-8 lead mb-3"><%= @train.manufacturer %></dd>
          <dt class="col-sm-4 text-muted fw-normal">Main Operator</dt>
          <dd class="col-sm-8 lead mb-0"><%= @train.main_operator %></dd>
        </dl>

        <div class="mt-4 d-flex gap-2 flex-wrap">
          <%= link_to "Back to List", trains_path, class: "btn btn-outline-secondary" %>
          <% if @train.user == current_user %>
            <%= link_to "✏️ Edit", edit_train_path(@train), class: "btn btn-outline-primary" %>
            <%= button_to "🗑 Delete", train_path(@train), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Are you sure you want to delete this entry?" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
