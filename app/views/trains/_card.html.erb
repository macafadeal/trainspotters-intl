<div class="card train-card h-100 border-0 shadow-sm">
  <%= link_to train, class: "text-decoration-none" do %>
    <% if train.photo.attached? %>
      <%= cl_image_tag train.photo.key, height: 200, width: 400, crop: :fill,
            class: "card-img-top", alt: "#{train.series} train photograph" %>
    <% else %>
      <div class="d-flex flex-column align-items-center justify-content-center" style="height:200px;background:#f8f9fa">
        <i class="bi bi-train-front-fill" style="font-size:2.75rem;color:#dee2e6"></i>
        <span class="mt-2" style="font-size:0.75rem;color:#adb5bd;letter-spacing:0.03em">No photo yet</span>
      </div>
    <% end %>
  <% end %>
  <div class="card-body px-3 py-3">
    <h5 class="card-title mb-1"><%= train.series %></h5>
    <p class="card-text text-muted mb-3">
      <%= train.manufacturer %> &middot; <%= train.main_operator %>
    </p>
    <%= link_to "View", train, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>
